{
	"name": "obsidian-bidi-mark-plugin",
	"version": "1.1.0",
	"description": "Right-click context menu and commands to insert bidi marks and clearly display them in the editor.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"format": "prettier -w .",
		"lint": "eslint .",
		"i18n:status": "npx i18next-cli status",
		"i18n:extract": "npx i18next-cli extract"
	},
	"keywords": [],
	"license": "0-BSD",
	"devDependencies": {
		"@codemirror/state": "^6.5.0",
		"@codemirror/view": "^6.38.6",
		"@eslint/js": "^9.39.4",
		"@ianvs/prettier-plugin-sort-imports": "^4.7.1",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"i18next": "^26.4.2",
		"i18next-cli": "^1.74.6",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"prettier": "^3.9.9",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	}
}
